# KIROSHI Production & Development Environment Setup

# 1. APPLICATION ENVIRONMENT
# Values: development | testing | production
ENVIRONMENT=development
PROJECT_NAME="KIROSHI Core Platform"
VERSION="1.0.0"
API_V1_STR=/api/v1

# 2. SECURITY & AUTHENTICATION
# CRITICAL: In production, generate a secure random 32-byte secret:
# Example: openssl rand -hex 32
SECRET_KEY=development-secret-key-do-not-use-in-production-change-me-0123456789abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. DATABASE CONFIGURATION
# Local Development Fallback: SQLite WAL
DATABASE_URL=sqlite:///./kiroshi.db
# Production / Docker PostGIS:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/kiroshi

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# 4. GEOSPATIAL & TELEMETRY POLICIES
LOCATION_FRESHNESS_LIVE_SECONDS=30
LOCATION_FRESHNESS_RECENT_SECONDS=180
MAX_GPS_CLOCK_SKEW_SECONDS=300
MAX_GPS_AGE_HOURS=24

# 5. CORS ORIGINS (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# 6. OBSERVABILITY & STRUCTURED LOGGING
# Log Levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Formats: json (machine-readable) | text (console dev)
LOG_FORMAT=json
