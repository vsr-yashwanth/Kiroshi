# KIROSHI Environment Configuration (v0.1)

# Application Environment (development, testing, production)
ENVIRONMENT=development
PROJECT_NAME="KIROSHI Core Platform"
API_V1_STR=/api/v1

# Security & JWT Tokens
# Generate with: openssl rand -hex 32
SECRET_KEY=development-secret-key-do-not-use-in-production-change-me-0123456789abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default local development fallback: SQLite WAL
# Production / Docker PostGIS: postgresql+psycopg2://postgres:postgres@localhost:5432/kiroshi
DATABASE_URL=sqlite:///./kiroshi.db

# CORS Configuration (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Logging
LOG_LEVEL=INFO
